# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# RESEND_API_KEY: Email API key for sending transactional emails.
# Get your key at https://resend.com/api-keys
# Used for booking confirmations and admin notifications
RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://cleandeep.co.za"

# DATABASE_URL: PostgreSQL connection string (e.g. from Neon, Supabase, or Railway).
# For serverless/Vercel add ?pgbouncer=true&connection_limit=1 if using a pooler.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ADMIN_PASSWORD: Password used to access /admin and /admin/:storeSlug dashboards.
# Set this in Vercel Environment Variables — never commit the real value here.
ADMIN_PASSWORD="change_me_before_deploying"

# SUPABASE: Used for image uploads (about photo, job gallery, testimonial avatars).
# Get these from your Supabase project: Settings -> API. A public storage bucket
# named "media" must exist (Storage -> New bucket -> name it "media" -> Public).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
