# ═══════════════════════════════════════════════════════════════════════════
# CLEANDEEP/TOTALLY APP - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
#
# IMPORTANT: This file contains example values only.
# For local development: Copy to .env and fill in real values
# For Vercel: Add these variables via Vercel dashboard (never commit .env)
#
# ═══════════════════════════════════════════════════════════════════════════

# ─── DATABASE (REQUIRED) ────────────────────────────────────────────────────
# PostgreSQL connection string from Neon, Supabase, or Railway
# For Vercel: Add ?pgbouncer=true&connection_limit=1 for connection pooling
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&channel_binding=require"

# ─── EMAIL CONFIGURATION (REQUIRED) ─────────────────────────────────────────
# Resend API key for transactional emails (booking confirmations, notifications)
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"

# Email sender configuration - who sends the emails
# SENDER_EMAIL: The actual email address (must be verified with Resend)
# SENDER_NAME: Display name in email clients
SENDER_EMAIL="info@cleandeep.co.za"
SENDER_NAME="TotalLŸ"

# ─── ADMIN SECURITY (REQUIRED) ──────────────────────────────────────────────
# Password for accessing admin dashboards at /admin/:storeSlug
# NEVER commit the real password to git - only examples here
# Change this to a strong password in production!
ADMIN_PASSWORD="totally2026"

# ─── SUPABASE STORAGE (REQUIRED FOR IMAGE UPLOADS) ──────────────────────────
# Image storage configuration for gallery uploads
# Get these from: https://app.supabase.com → Project Settings → API
#
# IMPORTANT: You must create a public bucket named "media" in Supabase Storage
# Steps: Go to Storage → New bucket → Name: "media" → Make it Public

# Public keys (safe to expose in browser - used by frontend)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret keys (server-only - NEVER expose to client)
SUPABASE_SECRET="your_secret_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# ─── APPLICATION URL (OPTIONAL) ─────────────────────────────────────────────
# Your application's public domain
# Used for generating links in emails and API responses
APP_URL="https://cleandeep.co.za"

# ─── AI/OPTIONAL FEATURES (OPTIONAL) ────────────────────────────────────────
# Gemini API key for AI features (if needed)
# Get your key at: https://makersuite.google.com/app/apikeys
GEMINI_API_KEY="your_gemini_api_key_here"

# ═══════════════════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Connect your repository to Vercel
#
# 2. Add environment variables in Vercel Dashboard:
#    Project Settings → Environment Variables
#    For each variable, set it for: Production, Preview, and Development
#
# REQUIRED VARIABLES (copy names exactly):
#    - DATABASE_URL
#    - RESEND_API_KEY
#    - SENDER_EMAIL
#    - SENDER_NAME
#    - ADMIN_PASSWORD
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_KEY
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - SUPABASE_SECRET
#    - SUPABASE_SERVICE_ROLE_KEY
#    - APP_URL (set to your Vercel domain)
#
# 3. Deploy:
#    Vercel will automatically:
#    → Run: npm run build
#    → Run: npx prisma migrate deploy
#    → Run: npx prisma db seed
#
# 4. Verify deployment by testing:
#    → Homepage loads correctly
#    → Admin dashboard accessible at /admin/deep-cleaning
#    → Can upload images in gallery
#    → Can edit testimonials
#    → Booking form works
#    → Confirmation emails send
#
# ═══════════════════════════════════════════════════════════════════════════
