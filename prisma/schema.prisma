// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  name                   String
  themeColor             String    @default("#000000")
  contactPhone           String
  contactEmail           String
  heroHeadline           String?
  tagline                String?
  missionText            String?
  aboutUsText            String?
  heroImageUrl           String?
  heroImageEnabled       Boolean   @default(true)
  heroImageOpacity       Int       @default(10)
  aboutImageUrl          String?
  customBlocks           Json?
  pageBackgroundImageUrl String?
  pageBackgroundEnabled  Boolean   @default(false)
  pageBackgroundOpacity  Int       @default(15)
  servicesHeadline       String?   @default("Our Specialised Services")
  servicesDescription    String?
  aboutHeading           String?   @default("Our Journey & Core Values")
  testimonialText        String?
  testimonialAuthor      String?
  testimonialAuthorRole  String?
  galleryImages          Json?
  deliveryNote           String?
  pageTitle              String?
  pageDescription        String?
  instagramUrl           String?
  facebookUrl            String?
  tiktokUrl              String?
  address                String?
  password               String?
  services               Service[]
  products               Product[]
  orders                 Order[]
  leads                  Lead[]
  testimonials           Testimonial[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  authorName   String
  authorRole   String?
  quote        String
  rating       Int      @default(5)
  avatarUrl    String?
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model Service {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  description String
  price       Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  description String
  price       Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
}

model Order {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String
  location      String
  status        String   @default("PENDING")
  requestedDate DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
}

model Lead {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  location          String
  status            String    @default("NEW")
  requestedDate     DateTime?
  notes             String?
  quoteAmount       Decimal?
  quoteMessage      String?
  quoteTokenHash    String?   @unique
  quoteStatus       String    @default("NONE")
  quoteSentAt       DateTime?
  quoteRespondedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([storeId])
}
